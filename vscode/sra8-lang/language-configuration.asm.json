{
  "comments": {
    "lineComment": ";"
  },
  "brackets": [],
  "autoClosingPairs": [
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "'",
      "close": "'",
      "notIn": [
        "string",
        "comment"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "\"",
      "\""
    ],
    [
      "'",
      "'"
    ]
  ],
  "wordPattern": "![A-Za-z_][A-Za-z0-9_]*|[A-Za-z_][A-Za-z0-9_.]*|#?-?(?:0[xXbBoOdD])?[0-9A-Fa-f]+"
}
